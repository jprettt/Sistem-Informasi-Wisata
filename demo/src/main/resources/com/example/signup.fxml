<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="900.0" prefWidth="1400.0" styleClass="root" stylesheets="@style.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.SignupController">
    <center>
        <HBox alignment="CENTER" spacing="0.0">
            <VBox alignment="CENTER" spacing="15.0" style="-fx-padding: 40; -fx-background-color: #C8D9E6;" HBox.hgrow="ALWAYS">
                <Label style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #2F4156;" text="Daftar Akun Baru" />
                <Label style="-fx-font-size: 14; -fx-text-fill: #567C8D;" text="Silakan isi data berikut untuk membuat akun" />
                
                <VBox spacing="14.0" styleClass="card" style="-fx-padding: 30 40 30 40; -fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-border-radius: 12;" prefWidth="460.0" maxWidth="460.0">
                    <VBox spacing="6.0">
                        <Label styleClass="subtitle" text="USERNAME" />
                        <TextField fx:id="usernameField" promptText="Pilih username" styleClass="search-field" style="-fx-border-radius: 8; -fx-background-radius: 8;" />
                    </VBox>

                    <VBox spacing="6.0">
                        <Label styleClass="subtitle" text="PASSWORD" />
                        <PasswordField fx:id="passwordField" promptText="Password" styleClass="search-field" style="-fx-border-radius: 8; -fx-background-radius: 8;" />
                    </VBox>

                    <VBox spacing="6.0">
                        <Label styleClass="subtitle" text="KONFIRMASI PASSWORD" />
                        <PasswordField fx:id="confirmPasswordField" promptText="Konfirmasi Password" styleClass="search-field" style="-fx-border-radius: 8; -fx-background-radius: 8;" />
                    </VBox>

                    <VBox spacing="6.0">
                        <Label styleClass="subtitle" text="NAMA LENGKAP" />
                        <TextField fx:id="namaLengkapField" promptText="Nama lengkap Anda" styleClass="search-field" style="-fx-border-radius: 8; -fx-background-radius: 8;" />
                    </VBox>

                    <VBox spacing="6.0">
                        <Label styleClass="subtitle" text="EMAIL" />
                        <TextField fx:id="emailField" promptText="email@contoh.com" styleClass="search-field" style="-fx-border-radius: 8; -fx-background-radius: 8;" />
                    </VBox>

                    <VBox spacing="6.0">
                        <Label styleClass="subtitle" text="TELEPON" />
                        <TextField fx:id="teleponField" promptText="08xxx" styleClass="search-field" style="-fx-border-radius: 8; -fx-background-radius: 8;" />
                    </VBox>

                    <VBox spacing="6.0">
                        <Label styleClass="subtitle" text="PERAN (ROLE)" />
                        <ComboBox fx:id="roleComboBox" prefWidth="400.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #B0C4D4; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #2F4156;" />
                    </VBox>

                    <Label fx:id="statusLabel" style="-fx-text-fill: #C0392B; -fx-font-size: 13;" text="" wrapText="true" />

                    <VBox spacing="10.0" style="-fx-padding: 10 0 0 0;">
                        <Button fx:id="registerButton" text="Daftar Sekarang" onAction="#handleRegister" minHeight="45.0" maxWidth="Infinity" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-background-color: #2F4156; -fx-text-fill: #FFFFFF; -fx-border-radius: 8; -fx-background-radius: 8;" />
                        <Button fx:id="backButton" text="Kembali ke Login" onAction="#handleBackToLogin" minHeight="40.0" maxWidth="Infinity" styleClass="secondary" style="-fx-font-size: 13; -fx-border-radius: 8; -fx-background-radius: 8;" />
                    </VBox>
                </VBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>
